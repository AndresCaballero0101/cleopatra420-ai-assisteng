# =============================================================================
# Cleopatra420 — configuración de IA (multi-proveedor)
# Copia este archivo como .env y rellena SOLO el proveedor que vayas a usar.
# =============================================================================

# --- Opción A: unificado (recomendado) ---------------------------------------
# Proveedor: xai | deepseek | opencloud | openai | openrouter | custom
# AI_PROVIDER=deepseek
# AI_API_KEY=tu_api_key_aqui
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com

# Si no pones AI_PROVIDER, se auto-detecta la primera clave disponible
# (orden: xai → deepseek → opencloud → openai → openrouter → custom).

# --- Opción B: por proveedor -------------------------------------------------

# 1) SpaceXAI / xAI (Grok) — https://console.x.ai
XAI_API_KEY=tu_api_key_aqui
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# 2) DeepSeek — https://platform.deepseek.com
# DEEPSEEK_API_KEY=tu_api_key_aqui
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 3) OpenCloud (API OpenAI-compatible) — ajusta BASE_URL a tu endpoint real
# OPENCLOUD_API_KEY=tu_api_key_aqui
# OPENCLOUD_MODEL=gpt-4o-mini
# OPENCLOUD_BASE_URL=https://api.opencloud.ai/v1

# 4) OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=tu_api_key_aqui
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 5) OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=tu_api_key_aqui
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 6) Custom — cualquier endpoint compatible con OpenAI Chat Completions
# CUSTOM_API_KEY=tu_api_key_aqui
# CUSTOM_MODEL=nombre-del-modelo
# CUSTOM_BASE_URL=https://tu-endpoint.ejemplo/v1
